{
  "name": "prompt-provenance-diff-action",
  "version": "0.1.0",
  "description": "GitHub Action that retrieves the previous version of a prompt-provenance document via `git show <base.sha>:<doc-path>`, diffs it against HEAD using prompt-provenance-diff, posts the structured diff as a PR comment, and fails the build on breaking changes. Third in the per-protocol diff Action quintet.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/prompt-provenance-diff-action"
  },
  "keywords": [
    "github-action",
    "actions",
    "prompt-provenance",
    "ai-prompts",
    "diff",
    "breaking-change",
    "ai-governance",
    "kinetic-gain-suite",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
